# VulBox configuration — copy to `.env` and edit for your host.
#
#   cp .env.example .env
#
# `.env` is gitignored and loaded at startup by app/core/config.py. Values here
# override the in-code defaults; a real process environment variable still
# overrides `.env`. This file is what makes production mode persist across
# restarts/reboots without re-exporting variables.

# --- Mode -------------------------------------------------------------------
# false = real assessment host (launches Docker/Trivy/Falco). true = replay
# fixtures from data/sample_outputs/ (demo/dev, zero-config).
VULBOX_DEV_MODE=false

# --- Security ---------------------------------------------------------------
# CHANGE THIS in production. JWT signing secret (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VULBOX_SECRET_KEY=change-me-to-a-long-random-string

# --- Target repo cache ------------------------------------------------------
# Remote repo_urls are cloned once into <dir>/<slug> and reused on later runs,
# so a transient `git clone` failure on a re-run falls back to the cached
# checkout instead of failing the build. Must be writable by the service user.
VULBOX_LOCAL_REPOS_DIR=/home/code/local-repos

# --- Sandbox posture --------------------------------------------------------
# Default read-only filesystem for targets without a .vulbox.yml. false lets
# the app write to its own disk inside the throwaway container — most real
# server stacks (tomcat/apache/rails/elasticsearch) need this just to boot;
# under read-only they crash on startup and the run fails before scanning.
# A target's .vulbox.yml `sandbox.read_only` still overrides this. Set true to
# re-lock the global default.
VULBOX_SANDBOX_READ_ONLY=false

# --- Exploitability coverage (EPSS) -----------------------------------------
# Gate for per-CVE fan-out matrix rows. 0.0 = off (attribute every motivating
# CVE). Raise (e.g. 0.3) to bound matrix size on large scans; KEV/ransomware
# CVEs are always attributed regardless. Refresh the snapshot periodically:
#   python scripts/fetch_epss.py
VULBOX_EPSS_MIN=0.0

# --- Trivy scan timeout -----------------------------------------------------
# Seconds for the Trivy image scan (passed to `trivy --timeout` and the
# subprocess). Default 600. Raise for very large images (e.g. OWASP Juice Shop,
# 900-1200). Pre-warm to avoid first-run DB/image downloads inside the window:
#   trivy image --download-db-only
#   docker pull <your-image>
VULBOX_TRIVY_TIMEOUT_SECS=600

# --- LLM remediation (Google Gemini) — optional -----------------------------
# Leave disabled to use the rule-based remediation path (no API key needed).
VULBOX_LLM_REMEDIATION=false
GEMINI_API_KEY=
VULBOX_LLM_MODEL_PRIMARY=gemini-2.5-flash
VULBOX_LLM_MODEL_BACKUP=gemini-2.5-flash-lite
# Findings at/above this risk_score get a Gemini call; the rest use the static
# rule. 25 = the report's high (orange) band, so high + critical findings get
# LLM guidance. Raise to 40 for critical-only.
VULBOX_LLM_MIN_RISK_SCORE=25
# Hard ceiling on Gemini calls per run (top-N highest-risk findings). Bounds
# free-tier quota even when a run has many high/critical findings. 0 = no cap.
VULBOX_LLM_MAX_CALLS=15
VULBOX_LLM_TIMEOUT_SECS=30
VULBOX_LLM_MAX_TOKENS=1024
VULBOX_LLM_EXEC_SUMMARY=true
